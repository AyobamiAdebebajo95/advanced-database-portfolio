erDiagram
    CUSTOMER ||--o{ ORDERS : places
    CUSTOMER ||--o{ INSPECTION : books
    CUSTOMER ||--o{ REVIEW : writes
    SELLER ||--o{ CAR_LISTING : "lists cars"
    SELLER ||--o{ PART : "sells parts"
    CAR_MODEL ||--o{ CAR_LISTING : "is the model of"
    CAR_MODEL ||--o{ PART_FITMENT : "takes"
    PART ||--o{ PART_FITMENT : "fits"
    PART_CATEGORY ||--o{ PART : groups
    CAR_LISTING ||--o{ INSPECTION : "is inspected in"
